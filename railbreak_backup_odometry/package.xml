<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>railbreak_backup_odometry</name>
  <version>0.1.0</version>
  <description>Backup tram odometry from two bogie speeds and the driver controller along a geodesic track map, with a 3 s GNSS start window and optional rare on-axis master RTK arc corrections.</description>
  <maintainer email="KonkovDV@users.noreply.github.com">KonkovDV</maintainer>
  <license>Provided to the organisers</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tram_vehicle_msgs</depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
