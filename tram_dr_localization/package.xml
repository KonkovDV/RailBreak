<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_dr_localization</name>
  <!-- Must track kModelVersion in include/tram_dr_localization/types.hpp. -->
  <version>0.0.9</version>
  <description>Backup tram dead-reckoning from controller notch and wheel speeds. No GNSS/IMU/lidar in the filter.</description>
  <maintainer email="KonkovDV@users.noreply.github.com">KonkovDV</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/KonkovDV/RailBreak</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
